# Environment Mode: "development", "staging", "production"
# In production, secure cookie flags, strict secret checks, and live SMTP backends are expected.
ENVIRONMENT=development

# Model Provider: "openrouter", "huggingface", "ollama", "gemini"
MODEL_PROVIDER=openrouter

# Official Gemma 4 Model Selection:
# - "google/gemma-4-31b-it" (Recommended dense model)
# - "google/gemma-4-26b-a4b-it" (High-efficiency MoE variant)
# - "google/gemma-4-12b-it"
# - "google/gemma-4-e4b-it"
GEMMA_MODEL_NAME=google/gemma-4-31b-it

# Provider Credentials (Keep private, never commit real keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Alternative Providers:
HUGGINGFACE_API_KEY=your_huggingface_token_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Upload and Security Configuration:
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Session Security:
AUTH_PUBLIC_APP_URL=http://localhost:5173
# Server-side HMAC secret for hashing 6-digit recovery/verification codes and state tokens.
# REQUIRED FOR PRODUCTION: Generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`.
# Kept strictly outside database and version control.
AUTH_SECRET_KEY=suchnasetu-dev-insecure-secret-key-change-in-production
AUTH_COOKIE_NAME=suchnasetu_session
# Set AUTH_COOKIE_SECURE=true when running under HTTPS in production
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_EXPIRE_HOURS=168
AUTH_TOKEN_EXPIRE_MINUTES=15
AUTH_VERIFY_EXPIRE_HOURS=24
DATABASE_PATH=backend/data/suchnasetu.db

# Email Delivery Configuration:
# - "console": DEVELOPMENT ONLY. Never sends actual emails; prints notification to dev terminal only.
# - "smtp": PRODUCTION READY. Transmits via authenticated SMTP server (TLS/STARTTLS).
AUTH_EMAIL_BACKEND=console

# SMTP Provider Settings (Required when AUTH_EMAIL_BACKEND=smtp):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# Ensure SMTP_FROM_EMAIL uses a domain you legitimately own and have SPF/DKIM configured for.
# Do NOT use unauthorized or assumed government domains.
SMTP_FROM_EMAIL=SuchnaSetu AI <notifications@example.com>
SMTP_USE_TLS=true

# Common Provider Setup Examples:
# Amazon SES:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USERNAME=<ses_smtp_username>
#   SMTP_PASSWORD=<ses_smtp_password>
#   SMTP_FROM_EMAIL=SuchnaSetu AI <verified-sender@yourdomain.org>
#
# SendGrid / Twilio:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=<sendgrid_api_key>
#   SMTP_FROM_EMAIL=SuchnaSetu AI <notifications@yourdomain.org>
#
# Google Workspace / Gmail (requires App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your_account@yourdomain.com
#   SMTP_PASSWORD=<16_character_app_password>
#   SMTP_FROM_EMAIL=SuchnaSetu AI <your_account@yourdomain.com>
