# SuchnaSetu AI — Configuration
# PS 02 — Notice-to-Action Accessibility Assistant
# Track 1 — Best Use of Gemma 4

# Model Provider: "openrouter", "huggingface", "ollama", "gemini"
MODEL_PROVIDER=openrouter

# Official Gemma 4 Model Selection:
# - "google/gemma-4-31b-it" (Recommended dense model)
# - "google/gemma-4-26b-a4b-it" (High-efficiency MoE variant)
# - "google/gemma-4-12b-it"
# - "google/gemma-4-e4b-it"
GEMMA_MODEL_NAME=google/gemma-4-31b-it

# Provider Credentials (Keep private, never commit real keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Alternative Providers:
HUGGINGFACE_API_KEY=your_huggingface_token_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Upload and Security Configuration:
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
